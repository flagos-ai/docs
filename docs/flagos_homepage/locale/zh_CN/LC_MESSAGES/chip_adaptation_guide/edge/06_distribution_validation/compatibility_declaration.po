msgid "The chip is verified as compatible in the distribution."
msgstr "该芯片在发行版中经验证兼容"

#: ../../chip_adaptation_guide/edge/06_distribution_validation/compatibility_declaration.md:1
msgid "Passes at least Level 1 validation."
msgstr "至少通过层级 1 验证"

#: ../../chip_adaptation_guide/edge/06_distribution_validation/compatibility_declaration.md:1
msgid "Community Support"
msgstr "Community Support"

#: ../../chip_adaptation_guide/edge/06_distribution_validation/compatibility_declaration.md:1
msgid "Community-driven support without official distribution validation."
msgstr "社区驱动，发行版未做官方验证"

#: ../../chip_adaptation_guide/edge/06_distribution_validation/compatibility_declaration.md:1
msgid "Only FlagOS CTS has passed."
msgstr "仅通过 FlagOS CTS"
