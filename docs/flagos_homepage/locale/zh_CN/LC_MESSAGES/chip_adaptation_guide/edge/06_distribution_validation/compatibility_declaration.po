#: ../../chip_adaptation_guide/edge/06_distribution_validation/compatibility_declaration.md:1
msgid "Certified"
msgstr "Certified"

#: ../../chip_adaptation_guide/edge/06_distribution_validation/compatibility_declaration.md:1
msgid "The chip is certified to run normally in the distribution."
msgstr "该芯片在发行版中经认证可正常运行"

#: ../../chip_adaptation_guide/edge/06_distribution_validation/compatibility_declaration.md:1
msgid "Passes Level 1 + Level 2 validation."
msgstr "通过层级 1 + 2 验证"

#: ../../chip_adaptation_guide/edge/06_distribution_validation/compatibility_declaration.md:1
msgid "Compatible"
